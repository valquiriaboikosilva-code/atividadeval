* {
    margin: 0;
    padding: 0;
}

.cabecalho {
    padding: 15px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(253, 113, 113);
}

.cartao {
    width: 260px;
    height: 200px;
    perspective: 1000px; /* necessário para o efeito 3D */
}

.cartao-imagem {
    width: 100%;
}

body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: rgb(243, 109, 172);
}

main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.cabecalho-link {
    color: rgb(241, 91, 129);
    text-decoration: none;
}

h1 {
    color: aliceblue;
    font-size: 24px;
}

footer {
    background-color: rgb(247, 113, 113);
    padding: 15px 25px;
    color: rgb(242, 238, 245);
}

.cartao-interno {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s;
    transform-style: preserve-3d;
}

.cartao:hover .cartao-interno {
    transform: rotateY(180deg);
}

.cartao-frente,
.cartao-verso {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    box-shadow: 0 6px 12px rgb(240, 119, 119);
    backface-visibility: hidden;
}

.cartao-verso {
    transform: rotateY(180deg);
}

header {
    background-color: brown;
    padding: 15px 25px;
    color: aliceblue;
}

section {
    display: flex;
    gap: 16px;
}
